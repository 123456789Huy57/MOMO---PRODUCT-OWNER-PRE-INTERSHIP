# Copy to .env.local for local runs. On Vercel, add the same names under Settings > Environment Variables.

# Neon Postgres connection string. Leave empty locally to use the built-in PGlite database in ./.pglite
DATABASE_URL=

# Gemini key from https://aistudio.google.com (Get API key). Without it the app reads sentences with the rule parser.
GEMINI_API_KEY=
# Model name as shown in AI Studio. Change it if AI Studio lists a different Flash-Lite model.
GEMINI_MODEL=gemini-flash-lite-latest

# Random string; Vercel Cron sends it when calling /api/jobs/recompute
CRON_SECRET=

# Set to off to hide the demo tools when other people try the prototype
DEMO_TOOLS=
